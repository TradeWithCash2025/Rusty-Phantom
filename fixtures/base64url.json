[
  {
    "description": "stringToBase64url: empty string",
    "fn": "base64url.stringToBase64url",
    "args": [
      ""
    ],
    "expected_encoded": "",
    "expected_decoded": ""
  },
  {
    "description": "stringToBase64url: Hello World",
    "fn": "base64url.stringToBase64url",
    "args": [
      "Hello World"
    ],
    "expected_encoded": "SGVsbG8gV29ybGQ",
    "expected_decoded": "Hello World"
  },
  {
    "description": "stringToBase64url: special chars",
    "fn": "base64url.stringToBase64url",
    "args": [
      "Special chars: !@#$%^&*()"
    ],
    "expected_encoded": "U3BlY2lhbCBjaGFyczogIUAjJCVeJiooKQ",
    "expected_decoded": "Special chars: !@#$%^&*()"
  },
  {
    "description": "stringToBase64url: JSON payload",
    "fn": "base64url.stringToBase64url",
    "args": [
      "{\"key\":\"value\",\"nested\":{\"a\":1}}"
    ],
    "expected_encoded": "eyJrZXkiOiJ2YWx1ZSIsIm5lc3RlZCI6eyJhIjoxfX0",
    "expected_decoded": "{\"key\":\"value\",\"nested\":{\"a\":1}}"
  },
  {
    "description": "stringToBase64url: multiline",
    "fn": "base64url.stringToBase64url",
    "args": [
      "Line1\nLine2\tTabbed"
    ],
    "expected_encoded": "TGluZTEKTGluZTIJVGFiYmVk",
    "expected_decoded": "Line1\nLine2\tTabbed"
  },
  {
    "description": "stringToBase64url: unicode emoji",
    "fn": "base64url.stringToBase64url",
    "args": [
      "Hello 🌍 World"
    ],
    "expected_encoded": "SGVsbG8g8J-MjSBXb3JsZA",
    "expected_decoded": "Hello 🌍 World"
  },
  {
    "description": "stringToBase64url: JWT-like",
    "fn": "base64url.stringToBase64url",
    "args": [
      "{\"sub\":\"1234567890\",\"name\":\"John Doe\",\"iat\":1516239022}"
    ],
    "expected_encoded": "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ",
    "expected_decoded": "{\"sub\":\"1234567890\",\"name\":\"John Doe\",\"iat\":1516239022}"
  },
  {
    "description": "stringToBase64url: Phantom string",
    "fn": "base64url.stringToBase64url",
    "args": [
      "Hello from Phantom!"
    ],
    "expected_encoded": "SGVsbG8gZnJvbSBQaGFudG9tIQ",
    "expected_decoded": "Hello from Phantom!"
  },
  {
    "description": "stringToBase64url: URL with params",
    "fn": "base64url.stringToBase64url",
    "args": [
      "https://example.com/path?a=1&b=2"
    ],
    "expected_encoded": "aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXRoP2E9MSZiPTI",
    "expected_decoded": "https://example.com/path?a=1&b=2"
  },
  {
    "description": "base64urlEncode bytes: empty bytes",
    "fn": "base64url.base64urlEncode",
    "args": [
      {
        "__bytes__": []
      }
    ],
    "expected_encoded": "",
    "expected_decoded_bytes": []
  },
  {
    "description": "base64urlEncode bytes: Hello bytes",
    "fn": "base64url.base64urlEncode",
    "args": [
      {
        "__bytes__": [
          72,
          101,
          108,
          108,
          111
        ]
      }
    ],
    "expected_encoded": "SGVsbG8",
    "expected_decoded_bytes": [
      72,
      101,
      108,
      108,
      111
    ]
  },
  {
    "description": "base64urlEncode bytes: single byte zero",
    "fn": "base64url.base64urlEncode",
    "args": [
      {
        "__bytes__": [
          0
        ]
      }
    ],
    "expected_encoded": "AA",
    "expected_decoded_bytes": [
      0
    ]
  },
  {
    "description": "base64urlEncode bytes: single byte 255",
    "fn": "base64url.base64urlEncode",
    "args": [
